# PulseLab OS - Production Environment Variables
PROJECT_NAME="PulseLab OS"
SECRET_KEY="generate_a_random_32_character_secret_here"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration:
# Option 1: SQLite (Default, embedded, zero setup needed)
DATABASE_URL="sqlite+aiosqlite:///app/pulselab.db"

# Option 2: Managed PostgreSQL (e.g. Supabase, Neon, AWS RDS, DigitalOcean)
# DATABASE_URL="postgresql+asyncpg://pulselab_admin:your_secure_password@postgres:5432/pulselab"

# Frontend API URL (defaults to /api/v1 through Nginx gateway)
NEXT_PUBLIC_API_URL="/api/v1"

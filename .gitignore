# ==============================================================================
# PulseLab OS - Master Git Ignore
# Protects all secret keys, database files, logs, and build artifacts
# ==============================================================================

# 1. Environment & Secret Credentials (CRITICAL - NEVER COMMIT)
.env
.env.*
!.env.example
!.env.production.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
frontend/.env.local
!frontend/.env.example

# 2. Database Files (Contains live patient records & credentials)
*.db
*.db-journal
*.db-wal
*.db.bak
*.sqlite
*.sqlite3
pulselab.db
backend/pulselab.db

# 3. Python Artifacts & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# 4. Node.js & Next.js Build Outputs
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
*.tsbuildinfo
next-env.d.ts

# 5. Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 6. Operating System & IDE Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# 7. Local Scratch Files & Backups
scratch/
scratch_*.py
check_*.py
test_match_*.py
*.pem
*.key
*.cert
